NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Opcional — WhatsApp Cloud API (Meta). Sem estas variáveis o sistema usa link wa.me como fallback.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ENTRY_TEMPLATE=

# Pagamento online/PIX não é acoplado a um provedor no núcleo do MVP.
# O pagamento no balcão por PIX/cartão/dinheiro/outro funciona normalmente.

# Opcional — provedor de consulta veicular. Endpoint deve aceitar ?plate=ABC1D23
# e retornar campos equivalentes a make/model/color/year (ou marca/modelo/cor/ano).
PLATE_API_URL=
PLATE_API_TOKEN=
