NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Opcional — WhatsApp Cloud API (Meta). Sem estas variáveis o sistema usa link wa.me como fallback.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ENTRY_TEMPLATE=

# Pagamento online/PIX não é acoplado a um provedor no núcleo do MVP.
# O pagamento no balcão por PIX/cartão/dinheiro/outro funciona normalmente.

# Opcional — provedor de consulta veicular. Endpoint deve aceitar ?plate=ABC1D23
# e retornar campos equivalentes a make/model/color/year (ou marca/modelo/cor/ano).
PLATE_API_URL=
PLATE_API_TOKEN=

# Admins Master da Plataforma autorizados a cadastrar novas empresas.
# Informe os UUIDs do Supabase Auth separados por vírgula.
# UUIDs do Supabase Auth para Vitor e Levi. Nunca use nomes ou e-mails.
# Exemplo: PLATFORM_ADMIN_USER_IDS=uuid-do-admin-1,uuid-do-admin-2
PLATFORM_ADMIN_USER_IDS=UUID_DO_ADMIN_1,UUID_DO_ADMIN_2

# Compatibilidade com a versão anterior. Use somente se PLATFORM_ADMIN_USER_IDS estiver vazio.
PLATFORM_ADMIN_USER_ID=

# Segredo server-only usado para anonimizar chaves do rate limit.
# Gere com: openssl rand -hex 32
RATE_LIMIT_SECRET=

# Ambiente de integração opcional (nunca use produção nos testes).
SUPABASE_TEST_URL=
SUPABASE_TEST_ANON_KEY=
SUPABASE_TEST_SERVICE_ROLE_KEY=
